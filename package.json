{
  "name": "@rahularya01/pi-cursor",
  "version": "1.4.36",
  "description": "Native Cursor provider for Pi Coding Agent (OAuth + Connect/protobuf streamSimple)",
  "author": "Rahul Arya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rahularya01/pi-cursor.git"
  },
  "homepage": "https://github.com/Rahularya01/pi-cursor#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Rahularya01"
  },
  "bugs": {
    "url": "https://github.com/Rahularya01/pi-cursor/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "cursor",
    "oauth",
    "provider"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "yarn build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security-check": "tsx scripts/security-check.ts",
    "proto:gen": "buf generate",
    "proto:sync": "tsx scripts/proto-sync.ts",
    "proto:check": "tsx scripts/proto-check.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:legacy": "tsx scripts/test-model-routing.ts && tsx scripts/test-thinking-levels.ts && tsx scripts/test-usage.ts && tsx scripts/test-context-mode-normalize.ts && tsx scripts/test-cli-auth.ts",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:models": "node scripts/smoke-models.mjs",
    "smoke:stream": "node scripts/smoke-stream.mjs",
    "smoke:wire": "node scripts/smoke-wire.mjs",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn security-check && yarn proto:check && yarn test && yarn test:legacy",
    "audit": "yarn npm audit --all --recursive --no-deprecations"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "resolutions": {
    "@earendil-works/pi-ai": "0.84.2",
    "esbuild": "0.28.2",
    "glob": "13.0.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.13.0",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.10.3"
}
